# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets
.env
*.env.local

# Data (regenerated via ingestion scripts, see src/data/)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model artifacts (regenerated via training scripts, see src/*)
models/*
!models/.gitkeep

# Experiment tracking
mlruns/
mlartifacts/

# Vector store
chroma_db/

# Prediction logs are runtime data, not committed. Drift reports under monitoring/reports/ ARE
# committed (T8.2 requires a real example report in-repo) — nothing to ignore there.
monitoring/logs/*.jsonl

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code local session state
.claude/

# Node (frontend, if applicable)
node_modules/
dist/
build/
