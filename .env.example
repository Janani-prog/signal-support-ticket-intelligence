# Signal — environment configuration
# Copy to .env and fill in as needed. No keys are required for the default local-only build.

# --- API ---
# Comma-separated list of origins allowed to call the API in production.
# Permissive "*" is fine for local dev only — see SECURITY_AND_ACCESS.md §3.
CORS_ALLOWED_ORIGINS=*

# --- MLflow ---
# Local file-based tracking URI (default: ./mlruns). No hosted server needed.
MLFLOW_TRACKING_URI=file:./mlruns

# --- Optional: lightweight demo access gate (SECURITY_AND_ACCESS.md §4) ---
# If set, the frontend/API can require this shared password to reduce free-tier abuse.
# Leave empty to keep the demo fully public/read-only.
DEMO_ACCESS_PASSWORD=

# --- Optional: hosted summarization fallback (TECHNICAL_ARCHITECTURE.md §2.2) ---
# Only needed if local flan-t5-base/bart-large-cnn latency is too high on free-tier hosting.
# Never commit a real key. Leave both empty to use the local-only summarization path.
GROQ_API_KEY=
HF_INFERENCE_API_TOKEN=
